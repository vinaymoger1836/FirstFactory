# Copy to .env (git-ignored) and fill in real values. Placeholders only here.
# docker compose reads ../.env via infra/docker-compose.yml (env_file).

# ── Environment ───────────────────────────────────────────────
APP_ENV=local                      # local | prod
LOG_LEVEL=info
PUBLIC_WEB_ORIGIN=http://localhost:5173   # CORS allowlist (comma-separated)
SITE_ADDRESS=:80                   # Caddy site address; e.g. api.example.com in prod

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=factory
DATABASE_URL=postgresql+asyncpg://factory:change-me-local-only@postgres:5432/factory
# Same DB for the job queue (procrastinate uses psycopg conninfo)
QUEUE_DATABASE_URL=postgresql://factory:change-me-local-only@postgres:5432/factory

# ── Redis (rate limits, token buckets, heartbeats) ─────────────
REDIS_URL=redis://redis:6379/0

# ── LLM providers (router roles map to these; see packages/agents) ──
GROQ_API_KEY=gsk_placeholder
GEMINI_API_KEY=placeholder
LLM_ROLE_REASONER=groq/openai/gpt-oss-120b
LLM_ROLE_EXTRACTOR=groq/llama-3.1-8b-instant
LLM_ROLE_WRITER=groq/openai/gpt-oss-120b
LLM_ROLE_VISION=gemini/gemini-2.5-flash

# ── Research (optional) ───────────────────────────────────────
TAVILY_API_KEY=tvly-placeholder

# ── Admin / edge (P8–P9) ──────────────────────────────────────
ADMIN_PASSCODE=placeholder
TURNSTILE_SECRET_KEY=placeholder
BYO_KEY_ENCRYPTION_KEY=placeholder-32-byte-base64
